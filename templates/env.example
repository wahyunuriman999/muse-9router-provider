# ---- identity: what the public sees ----
# Lowercase letters/numbers only. Your public model id = <PROVIDER_PREFIX>/muse-agent
PROVIDER_PREFIX=wx
# Lowercase letters/numbers/dashes. Public URL = https://<LT_SUBDOMAIN>.loca.lt
LT_SUBDOMAIN=my-muse-gateway
# Dedicated 9router API key name minted for your users (created by register-provider.sh)
KEY_NAME=my-apps

# ---- relay bridge ----
# Model id served by the bridge itself (9router exposes <PROVIDER_PREFIX>/<RELAY_MODEL_ID>)
RELAY_MODEL_ID=muse-agent
# Local ports (change only if something already listens there)
RELAY_PORT=20129
NINEROUTER_PORT=20128
# Where runtime data lives (queue/done/stale). Outside the repo on purpose.
DATA_DIR=$HOME/muse-9router-provider-data
# Where secrets live (600 files). Outside the repo on purpose.
SECRET_DIR=$HOME/.muse-9router-provider

# ---- tunnel ----
# Extra streams keep dashboard assets loading concurrently; 4-8 is fine
TUNNEL_STREAMS=6
